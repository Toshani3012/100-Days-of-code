#include <stdio.h>

struct Student {
    char name[20];
    int roll_no;
    float marks;
};

int main() {
    struct Student s;
    printf("Enter name, roll_no, marks: ");
    scanf("%s %d %f", s.name, &s.roll_no, &s.marks);

    printf("Student: %s, Roll: %d, Marks: %.2f\n", s.name, s.roll_no, s.marks);
    return 0;
}
