#include <stdio.h>

// Define a structure
struct Student {
    char name[20];
    int roll_no;
    float marks;
};

int main() {
    struct Student s;              // normal struct variable
    struct Student *ptr = &s;      // pointer to struct

    // Modify data using pointer and -> operator
    printf("Enter name, roll_no, marks: ");
    scanf("%s %d %f", ptr->name, &ptr->roll_no, &ptr->marks);

    // Display data using pointer
    printf("\n--- Student Details ---\n");
    printf("Name: %s\n", ptr->name);
    printf("Roll No: %d\n", ptr->roll_no);
    printf("Marks: %.2f\n", ptr->marks);

    return 0;
}
