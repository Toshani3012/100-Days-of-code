#include <stdio.h>

int main() {
    FILE *fp;
    char name[50];
    int roll, marks;

    fp = fopen("students.txt", "w");
    if (fp == NULL) {
        printf("Error opening file!\n");
        return 1;
    }

    // Writing records
    fprintf(fp, "Alice 101 85\n");
    fprintf(fp, "Bob 102 90\n");
    fprintf(fp, "Charlie 103 78\n");
    fclose(fp);

    // Reading records
    fp = fopen("students.txt", "r");
    printf("Student Records:\n");
    while (fscanf(fp, "%s %d %d", name, &roll, &marks) != EOF) {
        printf("Name: %s, Roll: %d, Marks: %d\n", name, roll, marks);
    }
    fclose(fp);

    return 0;
}
