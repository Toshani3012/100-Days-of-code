#include <stdio.h>

struct Student {
    char name[20];
    int roll_no;
    float marks;
};

void printStudent(struct Student s) {
    printf("Name: %s, Roll: %d, Marks: %.2f\n", s.name, s.roll_no, s.marks);
}

int main() {
    struct Student s = {"Amit", 101, 89.5};
    printStudent(s);
    return 0;
}
