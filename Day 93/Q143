#include <stdio.h>

struct Student {
    char name[20];
    int roll_no;
    float marks;
};

int main() {
    struct Student s[5];
    for (int i = 0; i < 5; i++) {
        printf("Enter name, roll_no, marks for student %d: ", i+1);
        scanf("%s %d %f", s[i].name, &s[i].roll_no, &s[i].marks);
    }

    int top = 0;
    for (int i = 1; i < 5; i++) {
        if (s[i].marks > s[top].marks) top = i;
    }

    printf("\nTop Student: %s | Roll: %d | Marks: %.2f\n", s[top].name, s[top].roll_no, s[top].marks);
    return 0;
}
