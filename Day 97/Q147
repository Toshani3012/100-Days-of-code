#include <stdio.h>
#include <stdlib.h>

struct Employee {
    char name[30];
    int id;
    float salary;
};

int main() {
    struct Employee e1 = {"Suresh", 102, 55000.0};
    struct Employee e2;

    // Write to binary file
    FILE *fp = fopen("employee.dat", "wb");
    if (!fp) { printf("File error\n"); return 1; }
    fwrite(&e1, sizeof(struct Employee), 1, fp);
    fclose(fp);

    // Read back
    fp = fopen("employee.dat", "rb");
    fread(&e2, sizeof(struct Employee), 1, fp);
    fclose(fp);

    printf("Employee Read: %s | ID: %d | Salary: %.2f\n", e2.name, e2.id, e2.salary);
    return 0;
}
